# Public application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated dashboard allowlist. These accounts are identity-only by default.
ADMIN_EMAILS=
# The only Google account permitted to connect the booking calendar.
CALENDAR_OWNER_EMAIL=
# Notification recipient; independent of dashboard access.
LYDIA_EMAIL=

# At least 32 random characters; used to encrypt the stored Google refresh token.
APP_ENCRYPTION_KEY=

# Google OAuth + Calendar. Use the same OAuth client configured in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BOOKING_CALENDAR_ID=primary

# Google Routes API. Set the origin to the public nearby landmark chosen privately.
GOOGLE_MAPS_API_KEY=
DELIVERY_ORIGIN_ADDRESS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Second Nature <hello@secondnaturecreative.com>"
